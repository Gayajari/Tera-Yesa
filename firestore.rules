rules_version = '2';

// ============================================================
// Firestore Security Rules
// - Siapa saja boleh MEMBACA collection "links" (dipakai index.html)
// - Hanya user yang sudah LOGIN yang boleh menulis/mengubah/menghapus
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    match /links/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Tolak akses ke collection lain secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
